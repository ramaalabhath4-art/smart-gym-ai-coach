# Database (Railway MySQL)
DATABASE_URL=mysql://root:bkGMRvUjoojasxuUKXXhYQWVJdnneZGA@maglev.proxy.rlwy.net:34184/railway

# Auth
JWT_SECRET=replace_with_a_random_32_character_secret_string
